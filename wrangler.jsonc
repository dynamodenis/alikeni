// Cloudflare Workers config (docs/DEPLOY.md). `pnpm build:worker` builds with
// @cloudflare/vite-plugin, which reads this file and writes the deployable
// config next to the bundle; `wrangler deploy` picks that up.
//
// Before the first deploy, replace every `<replace-me>` (see docs/DEPLOY.md):
//   - hyperdrive[0].id: from `wrangler hyperdrive create alikeni-db --connection-string=<neon url>`
//   - r2_buckets[0].bucket_name ("alikeni"): your R2 bucket for uploads
//   - vars.APP_ORIGIN: the public origin (workers.dev URL or custom domain)
// Secrets never go here: `wrangler secret put <NAME>` (list in docs/DEPLOY.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alikeni",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-20",
  // nodejs_compat: node:crypto, node:async_hooks, pg's net/tls sockets, and
  // vars/secrets in process.env (on by default from 2025-04-01).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "04e4fc5682d446569ac3875b9b8a901e",
      // `wrangler dev` / `pnpm preview:worker` connect here instead of the
      // real Hyperdrive: `pnpm db:local --port 55435`.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:55435/postgres",
    },
  ],
  // `wrangler dev` simulates this bucket locally (.wrangler/state); it never
  // touches the real one.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "alikeni",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_DRIVER": "binding",
    // The deployed origin (no trailing slash); change it when a custom domain is added.
    "APP_ORIGIN": "https://alikeni.dmbugua66.workers.dev",
    "GEOCODE_PROVIDER": "nominatim",
    // Currencies the Paystack account can charge (KES, USD).
    "PAYSTACK_CURRENCIES": "KES",
  },
}
