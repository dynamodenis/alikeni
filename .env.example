# ---- Server (never exposed to the browser) ----
NODE_ENV=development
# Public origin of this deployment; used for absolute share/OG URLs
APP_ORIGIN=http://localhost:3000
# Required by Nominatim's usage policy once geocoding is wired up (Phase 4)
GEOCODE_CONTACT_EMAIL=
# Geocoder: nominatim (default, keyless) | google | mapbox | radar (server-side keys)
GEOCODE_PROVIDER=nominatim
GOOGLE_GEOCODING_KEY=
MAPBOX_GEOCODING_TOKEN=
RADAR_SECRET_KEY=
# Neon Postgres: Dashboard > Connect > "Pooled connection" (host contains -pooler)
# e.g. postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/alikeni?sslmode=require
# Any local Postgres works too: postgresql://postgres:postgres@localhost:5432/alikeni
DATABASE_URL=
# When nobody is signed in, act as a fixed dev user instead of asking to sign
# in. Off unless "true"; for local demos and scripts only, never a deployment.
ALLOW_DEV_USER=false

# ---- Auth: Better Auth ----
# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google sign-in (optional; set both or neither). Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID > Web application.
# Authorized redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Guest protection (Phase 6) ----
# Salt for hashed guest IPs/user agents (rate limits, view dedupe). Optional:
# falls back to BETTER_AUTH_SECRET. openssl rand -base64 32
ANALYTICS_SALT=
# Cloudflare Turnstile (optional; set both or neither). Dashboard > Turnstile.
# Without the secret, RSVPs and wishes skip the bot check (fine in dev).
TURNSTILE_SECRET_KEY=

# ---- Payments: Paystack (Phase 9) ----
# Secret key from Paystack > Settings > API Keys & Webhooks: sk_test_… while
# testing, sk_live_… in production. Unset: the upgrade page says payments are
# not available. Webhook URL: <APP_ORIGIN>/api/payments/paystack
PAYSTACK_SECRET_KEY=
# Currencies the account can charge, comma-separated: KES, USD. The upgrade
# page offers only these. Kenyan accounts take USD once Paystack enables it.
PAYSTACK_CURRENCIES=KES

# ---- Email: Resend ----
# Required in production. Without it, development prints emails (reset and
# confirmation links) to the server log instead of sending them.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Alikeni <hello@yourdomain.com>
EMAIL_FROM=

# ---- Client (VITE_* only; anything here ships to the browser) ----
VITE_APP_NAME=Alikeni
# Google Maps Embed API key (free, unlimited). Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Map display adapter: google-embed (default, no key) | google-js | mapbox | radar | leaflet
VITE_MAP_DISPLAY_PROVIDER=google-embed
VITE_GOOGLE_MAPS_JS_KEY=
VITE_MAPBOX_TOKEN=
VITE_RADAR_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (pairs with TURNSTILE_SECRET_KEY)
VITE_TURNSTILE_SITE_KEY=
# Set to true to keep /dev/* routes reachable in a production build
VITE_ENABLE_DEV_ROUTES=false

# ---- Storage: Cloudflare R2 (Phase 4) ----
# STORAGE_DRIVER: binding | r2 | local | (blank = R2 when all five R2_* are
# set, else the Worker's BUCKET binding when present, else local in
# development). binding = Cloudflare Workers (see docs/DEPLOY.md and
# .dev.vars.example); r2 = R2 over the S3 API from Node; with r2, startup
# fails naming any missing variable.
# Never put real keys in this file: it is committed. Use .env.
STORAGE_DRIVER=
# Create an R2 API token with Object Read & Write on the bucket, enable public
# access (r2.dev or a custom domain) and set a CORS rule allowing PUT from
# APP_ORIGIN with the Content-Type header (see docs/STORAGE.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Signs upload URLs for the local and binding drivers; any long random string
# (required in production with binding: openssl rand -base64 32)
STORAGE_SIGNING_SECRET=

